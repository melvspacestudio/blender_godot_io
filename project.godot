; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Godot - GLTF Pipeline"
run/main_scene="uid://3w6unhktkuap"
config/features=PackedStringArray("4.7", "Forward Plus")
boot_splash/stretch_mode=0
boot_splash/image="uid://cnha1lndwgfpg"
config/icon="res://assets/logo/icon.svg"

[autoload]

ImmediateGizmos2D="*uid://dy3uarox5dcqv"
ImmediateGizmos3D="*uid://b1itedits8xid"

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/gdUnit4/plugin.cfg", "res://addons/godot_gltf_pipeline_addon/plugin.cfg", "res://addons/immediate_gizmos/plugin.cfg", "res://addons/quick_menu/plugin.cfg", "res://addons/script-ide/plugin.cfg")

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
